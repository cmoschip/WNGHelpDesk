@model TicketListViewModel
@{
    ViewData["Title"] = "All Tickets";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h2><i class="bi bi-ticket-detailed"></i> IT Help Desk Tickets</h2>
    </div>
</div>

<!-- Statistics Dashboard -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-exclamation-circle"></i> New</h5>
                <h2 class="card-text">@Model.NewTickets</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-gear"></i> In Progress</h5>
                <h2 class="card-text">@Model.InProgressTickets</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> High Priority</h5>
                <h2 class="card-text">@Model.HighPriorityTickets</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-calendar-x"></i> Overdue</h5>
                <h2 class="card-text">@Model.OverdueTickets</h2>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="card mb-4">
    <div class="card-header">
        <h5><i class="bi bi-funnel"></i> Search & Filter</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="searchTerm" value="@Model.SearchTerm" placeholder="Search tickets..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" name="statusFilter">
                            <option value="">All</option>
                            <option value="New" selected="@(Model.StatusFilter == "New")">New</option>
                            <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                            <option value="Resolved" selected="@(Model.StatusFilter == "Resolved")">Resolved</option>
                            <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="mb-3">
                        <label class="form-label">Priority</label>
                        <select class="form-select" name="priorityFilter">
                            <option value="">All</option>
                            <option value="Low" selected="@(Model.PriorityFilter == "Low")">Low</option>
                            <option value="Medium" selected="@(Model.PriorityFilter == "Medium")">Medium</option>
                            <option value="High" selected="@(Model.PriorityFilter == "High")">High</option>
                            <option value="Critical" selected="@(Model.PriorityFilter == "Critical")">Critical</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="categoryFilter">
                            <option value="">All</option>
                            <option value="Hardware" selected="@(Model.CategoryFilter == "Hardware")">Hardware</option>
                            <option value="Software" selected="@(Model.CategoryFilter == "Software")">Software</option>
                            <option value="Network" selected="@(Model.CategoryFilter == "Network")">Network</option>
                            <option value="Access/Permissions" selected="@(Model.CategoryFilter == "Access/Permissions")">Access/Permissions</option>
                            <option value="Other" selected="@(Model.CategoryFilter == "Other")">Other</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="mb-3">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tickets List -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-list-ul"></i> Tickets (@Model.Tickets.Count)</h5>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle"></i> New Ticket
        </a>
    </div>
    <div class="card-body">
        @if (Model.Tickets.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Category</th>
                            <th>Assigned To</th>
                            <th>Created</th>
                            <th>Due</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr class="@(ticket.IsOverdue ? "table-danger" : "")">
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.TicketId" class="fw-bold">
                                        #@ticket.TicketId
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.TicketId">
                                        @ticket.Title
                                    </a>
                                    @if (ticket.IsOverdue)
                                    {
                                        <span class="badge bg-danger">OVERDUE</span>
                                    }
                                </td>
                                <td>
                                    @switch (ticket.Status)
                                    {
                                        case "New":
                                            <span class="badge bg-primary">@ticket.Status</span>
                                            break;
                                        case "In Progress":
                                            <span class="badge bg-info">@ticket.Status</span>
                                            break;
                                        case "Resolved":
                                            <span class="badge bg-success">@ticket.Status</span>
                                            break;
                                        case "Closed":
                                            <span class="badge bg-secondary">@ticket.Status</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@ticket.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (ticket.Priority)
                                    {
                                        case "Critical":
                                            <span class="badge bg-danger">@ticket.Priority</span>
                                            break;
                                        case "High":
                                            <span class="badge bg-warning">@ticket.Priority</span>
                                            break;
                                        case "Medium":
                                            <span class="badge bg-info">@ticket.Priority</span>
                                            break;
                                        case "Low":
                                            <span class="badge bg-secondary">@ticket.Priority</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@ticket.Priority</span>
                                            break;
                                    }
                                </td>
                                <td>@ticket.Category</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(ticket.AssignedTo))
                                    {
                                        <text>@ticket.AssignedTo</text>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td>@ticket.CreatedDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @if (ticket.DueDate.HasValue)
                                    {
                                        @ticket.DueDate.Value.ToString("MM/dd/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> No tickets found matching your criteria.
            </div>
        }
    </div>
</div>
